# Sao chép thành .env và đặt giá trị thật. KHÔNG commit file .env.

# --- PostgreSQL (docker-compose và backend dùng chung) ---
POSTGRES_DB=ccp
POSTGRES_USER=ccp
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# --- Backend ---
# Khoá ký token, tối thiểu 32 ký tự ngẫu nhiên. Ví dụ tạo: openssl rand -base64 48
JWT_KEY=
# Super Admin đầu tiên (chỉ tạo khi chưa có Super Admin nào). Mật khẩu >= 8 ký tự, có chữ và số.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Nạp dữ liệu mẫu ngành nước hoa khi khởi động (chỉ để demo): true | false
Seed__Demo=false

# Thư mục lưu tệp tải lên (kho Local). Mặc định: ./uploads cạnh nơi chạy.
# Storage__LocalPath=uploads

# --- Triển khai production (docker-compose.prod.yml, xem docs/DEPLOY.md) ---
# Địa chỉ công khai của cửa hàng, không có dấu / ở cuối (canonical, sitemap, Open Graph)
SITE_URL=https://shop.example.com
# Chuỗi bí mật để API gọi làm mới đệm Storefront. Ví dụ tạo: openssl rand -hex 32
REVALIDATE_SECRET=
# Cổng mở ra ngoài của nginx (mặc định 80)
# HTTP_PORT=80

# --- Email (quên mật khẩu, xác nhận đơn hàng). Bỏ trống SMTP_HOST thì chỉ ghi nhật ký, không gửi thật ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=shop@example.com
# SMTP_FROM_NAME=Tên cửa hàng
# StartTls (587) | Ssl (465) | None
# SMTP_SECURITY=StartTls
